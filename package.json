{
  "name": "jobhelper",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first BYOK desktop job application assistant with human-in-the-loop browser control",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace @jobhelper/desktop run dev",
    "dev:workbench": "npm --workspace @jobhelper/workbench run dev",
    "build": "tsc -b",
    "typecheck": "tsc -b --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gate1": "echo \"[M5 Gate 1] Acceptance test harness not implemented yet. See docs/ACCEPTANCE_GATE1.md\"",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
